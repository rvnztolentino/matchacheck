# Spotify API credentials — get yours at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Full Spotify URL of your matcha playlist
# Example: https://open.spotify.com/playlist/37i9dQZF1DX6XceWZP1znY
SPOTIFY_PERFORMATIVE_URL=https://open.spotify.com/playlist/YOUR_PLAYLIST_ID

# For Premium users — the spotify: URI version of the same playlist
# Example: spotify:playlist:37i9dQZF1DX6XceWZP1znY
SPOTIFY_PERFORMATIVE_URI=spotify:playlist:YOUR_PLAYLIST_ID
